# Copie para .env e ajuste os valores:  cp .env.example .env
# O arquivo .env está no .gitignore e nunca deve ser commitado.

# ── Banco Oracle (container local) ──────────────────────────────
ORACLE_PASSWORD=TroqueEstaSenha123
ORACLE_APP_USER=eco
ORACLE_APP_PASSWORD=TroqueEstaSenha123
ORACLE_PORT=1521

# ── API ─────────────────────────────────────────────────────────
API_PORT=8080
ASPNETCORE_ENVIRONMENT=Development

# Usuário/senha do POST /api/auth/login
AUTH_USERNAME=admin
AUTH_PASSWORD=TroqueEstaSenha123

# Chave de assinatura do JWT (mínimo 32 caracteres)
AUTH_JWT_KEY=troque-esta-chave-por-uma-chave-com-32-ou-mais-caracteres
