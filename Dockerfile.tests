# ─────────────────────────────────────────────────────────────────────────────
# Imagem para executar os testes BDD (Reqnroll + Gherkin) de API em .NET 8,
# sem precisar instalar nada além do Docker.
#
#   docker build -f Dockerfile.tests -t eco-compliance-bdd .
#   docker run --rm -v "$PWD/TestResults:/src/TestResults" eco-compliance-bdd
#
# Relatórios gerados em ./TestResults: relatorio-bdd.html e bdd-results.trx
# ─────────────────────────────────────────────────────────────────────────────
FROM mcr.microsoft.com/dotnet/sdk:8.0
WORKDIR /src

# Restore separado do código-fonte: aproveita o cache de camadas
COPY ["EcoCompliance.API/EcoCompliance.API.csproj", "EcoCompliance.API/"]
COPY ["EcoCompliance.BddTests/EcoCompliance.BddTests.csproj", "EcoCompliance.BddTests/"]
RUN dotnet restore "EcoCompliance.BddTests/EcoCompliance.BddTests.csproj"

COPY EcoCompliance.API/ EcoCompliance.API/
COPY EcoCompliance.BddTests/ EcoCompliance.BddTests/
RUN dotnet build "EcoCompliance.BddTests/EcoCompliance.BddTests.csproj" -c Release --no-restore

ENTRYPOINT ["dotnet", "test", "EcoCompliance.BddTests/EcoCompliance.BddTests.csproj", \
            "-c", "Release", "--no-build", \
            "--logger", "trx;LogFileName=bdd-results.trx", \
            "--logger", "console;verbosity=normal", \
            "--results-directory", "/src/TestResults"]
