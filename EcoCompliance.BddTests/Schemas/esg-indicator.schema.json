{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Indicador ESG",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer",
      "minimum": 1
    },
    "companyId": {
      "type": "integer",
      "minimum": 1
    },
    "companyName": {
      "type": "string"
    },
    "indicatorType": {
      "type": "string",
      "minLength": 1
    },
    "value": {
      "type": "number",
      "minimum": 0
    },
    "unit": {
      "type": [
        "string",
        "null"
      ]
    },
    "measuredAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "id",
    "companyId",
    "companyName",
    "indicatorType",
    "value",
    "unit",
    "measuredAt"
  ],
  "additionalProperties": false
}
