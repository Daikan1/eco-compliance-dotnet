{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Erro padronizado (GlobalExceptionMiddleware)",
  "type": "object",
  "properties": {
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "integer",
      "enum": [
        400,
        404,
        500
      ]
    },
    "error": {
      "type": "string",
      "minLength": 1
    },
    "message": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "timestamp",
    "status",
    "error",
    "message"
  ],
  "additionalProperties": false
}
