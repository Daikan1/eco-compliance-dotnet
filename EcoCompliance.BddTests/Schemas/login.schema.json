{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Token JWT (POST /api/auth/login)",
  "type": "object",
  "properties": {
    "token": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "token",
    "expiresAt"
  ],
  "additionalProperties": false
}
