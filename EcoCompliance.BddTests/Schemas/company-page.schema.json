{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Página de empresas",
  "$defs": {
    "item": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "cnpj": {
          "type": [
            "string",
            "null"
          ]
        },
        "sector": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "name",
        "cnpj",
        "sector"
      ],
      "additionalProperties": false
    }
  },
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "totalCount": {
      "type": "integer",
      "minimum": 0
    },
    "page": {
      "type": "integer",
      "minimum": 1
    },
    "pageSize": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "totalPages": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "items",
    "totalCount",
    "page",
    "pageSize",
    "totalPages"
  ],
  "additionalProperties": false
}
