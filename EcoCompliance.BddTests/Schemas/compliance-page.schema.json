{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Página de registros de compliance",
  "$defs": {
    "item": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "companyId": {
          "type": "integer",
          "minimum": 1
        },
        "companyName": {
          "type": "string"
        },
        "complianceType": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "reportDate": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "companyId",
        "companyName",
        "complianceType",
        "status",
        "reportDate"
      ],
      "additionalProperties": false
    }
  },
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "totalCount": {
      "type": "integer",
      "minimum": 0
    },
    "page": {
      "type": "integer",
      "minimum": 1
    },
    "pageSize": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "totalPages": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "items",
    "totalCount",
    "page",
    "pageSize",
    "totalPages"
  ],
  "additionalProperties": false
}
